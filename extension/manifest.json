{
  "manifest_version": 3,
  "name": "Facebook / Threads 快速封鎖",
  "version": "0.4.1",
  "description": "在 Facebook 與 Threads 作者旁加入快速封鎖按鈕，依序處理佇列。",
  "minimum_chrome_version": "102",
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "core.js",
        "api.js",
        "queue.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.threads.com/*",
        "https://www.threads.net/*",
        "https://threads.com/*",
        "https://threads.net/*"
      ],
      "js": [
        "core.js",
        "threads.js",
        "queue.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Facebook / Threads 快速封鎖"
  }
}
